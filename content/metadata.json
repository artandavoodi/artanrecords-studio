{
  "schemaVersion": 1,
  "publication": {
    "artistPrivateFields": ["portrait_permission"],
    "artistBaseFields": [
      "artist_name",
      "biography",
      "website"
    ],
    "releaseFields": [
      "title",
      "type",
      "version",
      "primary_artist",
      "record_label",
      "release_date",
      "language",
      "genre",
      "secondary_genre",
      "description",
      "story",
      "production_process",
      "release_information",
      "musical_details",
      "links",
      "tracks"
    ],
    "trackFields": [
      "number",
      "title",
      "version",
      "primary_artist",
      "featured_artists",
      "language",
      "explicit",
      "instrumental",
      "duration",
      "release_date",
      "credits",
      "musical_details",
      "key",
      "tempo",
      "structure",
      "production_process",
      "story",
      "lyrics"
    ]
  },
  "artist": {
    "title": "Artist catalogue information",
    "notice": "Save information for a future artist page. This is private draft information, not automatic publication. Your sign-in email stays separate from any public contact address.",
    "groups": [
      {
        "id": "identity",
        "title": "Artist details",
        "fields": [
          {
            "name": "years_active_start",
            "label": "Active since",
            "type": "number",
            "min": 1900,
            "max": 2100
          },
          {
            "name": "years_active_end",
            "label": "Active until (leave blank if current)",
            "type": "number",
            "min": 1900,
            "max": 2100
          },
          {
            "name": "genre",
            "label": "Genres",
            "maxLength": 200
          },
          {
            "name": "location",
            "label": "Public location or region",
            "maxLength": 200
          },
          {
            "name": "pronouns",
            "label": "Pronouns",
            "maxLength": 100
          },
          {
            "name": "short_biography",
            "label": "Short biography",
            "type": "textarea",
            "maxLength": 500
          }
        ],
        "icon": "profile"
      },
      {
        "id": "streaming",
        "title": "Streaming profiles",
        "fields": [
          {
            "name": "apple_music",
            "icon": "apple_music",
            "label": "Apple Music",
            "type": "url",
            "hosts": [
              "music.apple.com"
            ]
          },
          {
            "name": "spotify",
            "icon": "spotify",
            "label": "Spotify",
            "type": "url",
            "hosts": [
              "open.spotify.com"
            ]
          },
          {
            "name": "youtube_music",
            "icon": "youtube_music",
            "label": "YouTube Music",
            "type": "url",
            "hosts": [
              "music.youtube.com"
            ]
          },
          {
            "name": "amazon_music",
            "icon": "amazon_music",
            "label": "Amazon Music",
            "type": "url",
            "hosts": [
              "music.amazon.com",
              "music.amazon.de",
              "music.amazon.co.uk"
            ]
          },
          {
            "name": "deezer",
            "icon": "deezer",
            "label": "Deezer",
            "type": "url",
            "hosts": [
              "deezer.com",
              "link.deezer.com"
            ]
          },
          {
            "name": "tidal",
            "icon": "tidal",
            "label": "TIDAL",
            "type": "url",
            "hosts": [
              "tidal.com"
            ]
          },
          {
            "name": "bandcamp",
            "label": "Bandcamp",
            "type": "url",
            "hosts": [
              "bandcamp.com"
            ]
          },
          {
            "name": "soundcloud",
            "icon": "soundcloud",
            "label": "SoundCloud",
            "type": "url",
            "hosts": [
              "soundcloud.com"
            ]
          }
        ],
        "icon": "music"
      },
      {
        "id": "social",
        "title": "Social profiles",
        "fields": [
          {
            "name": "instagram",
            "icon": "instagram",
            "label": "Instagram",
            "type": "url",
            "hosts": [
              "instagram.com"
            ]
          },
          {
            "name": "youtube",
            "icon": "youtube",
            "label": "YouTube channel",
            "type": "url",
            "hosts": [
              "youtube.com"
            ]
          },
          {
            "name": "tiktok",
            "icon": "tiktok",
            "label": "TikTok",
            "type": "url",
            "hosts": [
              "tiktok.com"
            ]
          },
          {
            "name": "facebook",
            "icon": "facebook",
            "label": "Facebook",
            "type": "url",
            "hosts": [
              "facebook.com"
            ]
          },
          {
            "name": "x",
            "icon": "x",
            "label": "X",
            "type": "url",
            "hosts": [
              "x.com",
              "twitter.com"
            ]
          },
          {
            "name": "threads",
            "label": "Threads",
            "type": "url",
            "hosts": [
              "threads.net",
              "threads.com"
            ]
          }
        ],
        "icon": "social"
      },
      {
        "id": "contact",
        "title": "Public contact and websites",
        "fields": [
          {
            "name": "public_email",
            "label": "Public artist contact email",
            "type": "email",
            "maxLength": 254
          },
          {
            "name": "booking_email",
            "label": "Booking contact email",
            "type": "email",
            "maxLength": 254
          },
          {
            "name": "management_email",
            "label": "Management contact email",
            "type": "email",
            "maxLength": 254
          },
          {
            "name": "concerts_url",
            "label": "Concerts or tour page",
            "type": "url"
          },
          {
            "name": "public_hub",
            "label": "Artist hub",
            "type": "url"
          },
          {
            "name": "press_url",
            "label": "Press kit",
            "type": "url"
          },
          {
            "name": "store_url",
            "label": "Official artist store",
            "type": "url"
          },
          {
            "name": "other_platforms",
            "label": "Other platforms and links",
            "type": "textarea",
            "maxLength": 2000
          }
        ],
        "icon": "email"
      },
      {
        "id": "presentation",
        "title": "Portrait and presentation",
        "fields": [
          { "name": "catalogue_background", "label": "Catalogue background", "type": "select", "options": ["Latest release", "None", "Profile image"] },
          {
            "name": "portrait_alt",
            "label": "Portrait description",
            "maxLength": 300
          },
          {
            "name": "portrait_credit",
            "label": "Photographer credit",
            "maxLength": 300
          },
          {
            "name": "portrait_permission",
            "label": "Portrait permission or credit notes",
            "type": "textarea",
            "maxLength": 1000
          }
        ],
        "icon": "image"
      }
    ]
  },
  "release": {
    "title": "Prepare a release",
    "notice": "Save a private metadata draft for a single, EP or album. Saving does not submit music, create an agreement, publish a page or deliver to streaming services. Do not enter banking information or upload masters here.",
    "fields": [
      {
        "name": "title",
        "label": "Release title",
        "required": true,
        "maxLength": 200
      },
      {
        "name": "type",
        "label": "Release type",
        "type": "select",
        "options": [
          "Single",
          "EP",
          "Album"
        ]
      },
      {
        "name": "version",
        "label": "Version (for example Live Acoustic)",
        "maxLength": 100
      },
      {
        "name": "primary_artist",
        "label": "Primary artist or group",
        "maxLength": 200
      },
      {"name":"record_label","label":"Record label","maxLength":200},
      {"name":"copyright_year","label":"Copyright year","type":"number","min":1900,"max":2100},
      {"name":"recording_year","label":"Master recording copyright year","type":"number","min":1900,"max":2100},
      {
        "name": "release_date",
        "label": "Requested release date",
        "type": "date"
      },
      {
        "name": "original_date",
        "label": "Original release date, if previously released",
        "type": "date"
      },
      {
        "name": "language",
        "label": "Primary language",
        "maxLength": 100
      },
      {
        "name": "genre",
        "label": "Primary genre",
        "maxLength": 100
      },
      {
        "name": "secondary_genre",
        "label": "Secondary genre",
        "maxLength": 100
      },
      {
        "name": "upc",
        "label": "Existing UPC or EAN (if assigned)",
        "maxLength": 13
      },
      {
        "name": "description",
        "label": "Release description",
        "type": "textarea",
        "maxLength": 2000
      },
      {
        "name": "story",
        "label": "Story behind the release",
        "type": "textarea",
        "maxLength": 5000
      },
      {
        "name": "production_process",
        "label": "How the recording was made, including any AI involvement",
        "type": "textarea",
        "maxLength": 5000
      },
      {
        "name": "copyright_owner",
        "label": "Copyright owner",
        "maxLength": 200
      },
      { "name": "release_information", "label": "Release information", "type": "textarea", "maxLength": 5000 },
      { "name": "musical_details", "label": "Musical details", "type": "textarea", "maxLength": 5000 },
      {
        "name": "phonographic_owner",
        "label": "Master recording owner",
        "maxLength": 200
      },
      {
        "name": "artwork_url",
        "label": "Private artwork reference link",
        "type": "url"
      },
      {
        "name": "artwork_credit",
        "label": "Artwork credit and AI disclosure",
        "maxLength": 1000
      },
      {
        "name": "rights_notes",
        "label": "Rights, samples and cover-song permissions to review",
        "type": "textarea",
        "maxLength": 2000
      }
    ],
    "trackFields": [
      {
        "name": "title",
        "label": "Track title",
        "required": true,
        "maxLength": 200
      },
      {
        "name": "version",
        "label": "Track version",
        "maxLength": 100
      },
      {
        "name": "primary_artist",
        "label": "Primary artist",
        "maxLength": 200
      },
      {
        "name": "featured_artists",
        "label": "Featured artists",
        "maxLength": 500
      },
      {
        "name": "language",
        "label": "Lyrics language",
        "maxLength": 100
      },
      {
        "name": "explicit",
        "label": "Explicit content",
        "type": "select",
        "options": [
          "Not specified",
          "Clean",
          "Explicit"
        ]
      },
      {
        "name": "instrumental",
        "label": "Instrumental (no lyrics)",
        "type": "checkbox"
      },
      {"name":"composition_type","label":"Songwriting","type":"select","options":["Not specified","Original song","Cover song"]},
      {"name":"original_artist","label":"Original artist (for a cover song)","maxLength":200},
      {"name":"original_song_title","label":"Original song title (for a cover song)","maxLength":200},
      {"name":"clean_version","label":"This is a clean edit of an explicit recording","type":"checkbox"},
      {"name":"preview_start","label":"Preferred preview start (minutes:seconds)","maxLength":8},
      {
        "name": "isrc",
        "label": "Existing ISRC (if assigned)",
        "maxLength": 12
      },
      {
        "name": "duration",
        "label": "Duration (minutes:seconds)",
        "maxLength": 8
      },
      {
        "name": "audio_url",
        "label": "Private listening reference",
        "type": "url"
      },
      {
        "name": "story",
        "label": "Track story",
        "type": "textarea",
        "maxLength": 5000
      },
      { "name": "release_date", "label": "Track release date", "type": "date" },
      { "name": "credits", "label": "Public-facing credits (approved display names)", "type": "textarea", "maxLength": 5000 },
      { "name": "musical_details", "label": "Musical details", "type": "textarea", "maxLength": 5000 },
      { "name": "key", "label": "Musical key", "maxLength": 100 },
      { "name": "tempo", "label": "Tempo", "maxLength": 100 },
      { "name": "structure", "label": "Song structure", "maxLength": 2000 },
      { "name": "production_process", "label": "Recording and production notes", "type": "textarea", "maxLength": 5000 },
      { "name": "music_sheet_url", "label": "Music sheet reference (private review link)", "type": "url" },
      { "name": "music_sheet_notes", "label": "Music sheet description and permissions", "type": "textarea", "maxLength": 2000 },
      { "name": "performance_url", "label": "Performance video reference (private review link)", "type": "url" },
      { "name": "performance_notes", "label": "Performance description and credits", "type": "textarea", "maxLength": 2000 },
      {
        "name": "lyrics",
        "label": "Lyrics",
        "type": "textarea",
        "maxLength": 20000
      }
    ],
    "roles": [
      "Songwriter",
      "Composer",
      "Lyricist",
      "Producer",
      "Performer",
      "Featured artist",
      "Remixer",
      "Mixing engineer",
      "Mastering engineer"
    ],
    "linkFields": [
      {
        "name": "apple_music",
        "label": "Apple Music release",
        "icon": "apple_music",
        "type": "url"
      },
      {
        "name": "spotify",
        "label": "Spotify release",
        "icon": "spotify",
        "type": "url"
      },
      {
        "name": "youtube_music",
        "label": "YouTube Music release",
        "icon": "youtube_music",
        "type": "url"
      },
      {
        "name": "amazon_music",
        "label": "Amazon Music release",
        "icon": "amazon_music",
        "type": "url"
      },
      {
        "name": "deezer",
        "label": "Deezer release",
        "icon": "deezer",
        "type": "url"
      },
      {
        "name": "tidal",
        "label": "TIDAL release",
        "icon": "tidal",
        "type": "url"
      },
      {
        "name": "video",
        "label": "Official video",
        "type": "url"
      }
    ],
    "groups": [
      {
        "title": "Release details",
        "fields": [
          "title",
          "type",
          "version",
          "primary_artist",
          "record_label"
        ]
      },
      {
        "title": "Schedule and classification",
        "fields": [
          "release_date",
          "original_date",
          "language",
          "genre",
          "secondary_genre",
          "upc"
        ]
      },
      {
        "title": "Release story",
        "fields": [
          "description",
          "story",
          "release_information",
          "musical_details",
          "production_process"
        ]
      },
      {
        "title": "Rights and artwork",
        "fields": [
          "copyright_owner",
          "copyright_year",
          "phonographic_owner",
          "recording_year",
          "artwork_url",
          "artwork_credit",
          "rights_notes"
        ]
      }
    ],
    "trackGroups": [
      { "title": "Track details", "fields": ["title", "version", "primary_artist", "featured_artists", "language", "explicit", "instrumental", "isrc", "duration", "release_date"] },
      { "title": "Songwriting and preview", "fields": ["composition_type", "original_artist", "original_song_title", "clean_version", "preview_start"] },
      { "title": "Story and lyrics", "fields": ["story", "lyrics"] },
      { "title": "Music and production", "fields": ["musical_details", "key", "tempo", "structure", "production_process", "audio_url"] },
      { "title": "Credits", "fields": ["credits"] },
      { "title": "Scores and performances", "fields": ["music_sheet_url", "music_sheet_notes", "performance_url", "performance_notes"] }
    ],
    "maxTracks": 20,
    "maxContributors": 30
  }
}
